worker_processes auto;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  server_tokens off;

  sendfile on;
  keepalive_timeout 65;
  keepalive_requests 1000;
  client_max_body_size 50m;
  client_header_buffer_size 8k;
  large_client_header_buffers 4 32k;

  # Timeouts
  proxy_connect_timeout 5s;
  proxy_send_timeout 30s;
  proxy_read_timeout 30s;
  send_timeout 30s;

  # Rate / connection limits (per client IP)
  limit_req_zone $binary_remote_addr zone=api_ratelimit:10m rate=20r/s;
  limit_conn_zone $binary_remote_addr zone=api_conns:10m;
  limit_req_status 429;
  limit_conn_status 429;

  # Upstream pools resolved once at start (no per-request resolver needed)
  upstream base_upstream { server ${NGINX_GATEWAY_BASE_UPSTREAM_HOST}:${NGINX_GATEWAY_BASE_UPSTREAM_PORT}; }
  upstream album_upstream { server ${NGINX_GATEWAY_IMAGE_UPSTREAM_HOST}:${NGINX_GATEWAY_IMAGE_UPSTREAM_PORT}; }
  upstream llm_upstream { server ${NGINX_GATEWAY_LLM_UPSTREAM_HOST}:${NGINX_GATEWAY_LLM_UPSTREAM_PORT}; }
  upstream account_upstream { server ${NGINX_GATEWAY_ACCOUNT_UPSTREAM_HOST}:${NGINX_GATEWAY_ACCOUNT_UPSTREAM_PORT}; }

  # Map service prefix to upstream pool name
  map $service $api_upstream {
    default "";
    base     base_upstream;
    album    album_upstream;
    llm      llm_upstream;
    account  account_upstream;
  }

  server {
    listen ${NGINX_GATEWAY_LISTEN_PORT};
    server_name _;

    # Common security headers
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "geolocation=(),camera=(),microphone=(),payment=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Redirect bare host to docs home
    location = / {
      return 301 $scheme://$host/docs/;
    }

    location = /docs {
      return 301 $scheme://$host/docs/;
    }

    location = /docs/ {
      root /usr/share/nginx/html;
      index index.html;
      try_files /docs/index.html =404;
      add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'" always;
    }

    location = /docs/specs/openapi.yaml {
      root /usr/share/nginx/html;
      default_type application/yaml;
      types {
        application/yaml yaml yml;
      }
    }

    location = /docs/favicon.svg {
      root /usr/share/nginx/html;
      default_type image/svg+xml;
      try_files /docs/favicon.svg =404;
    }

    # Unified API proxy with CORS + preflight handling (no resolver; upstream names are static)
    location ~ ^/v1/(?<service>base|album|llm|account)(?<tail>/.*)?$ {
      add_header Access-Control-Allow-Origin $http_origin always;
      add_header Access-Control-Allow-Credentials "true" always;
      add_header Access-Control-Allow-Headers "Authorization,Content-Type,Accept,Origin,Cache-Control,X-Requested-With" always;
      add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
      add_header Vary "Origin" always;

      if ($request_method = OPTIONS) { return 204; }
      if ($request_method !~ ^(GET|POST|PUT|PATCH|DELETE|OPTIONS)$) { return 405; }

      limit_req zone=api_ratelimit burst=40 nodelay;
      limit_conn api_conns 40;

      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Authorization $http_authorization;

      if ($api_upstream = "") { return 404; }
      proxy_pass http://$api_upstream;
    }

    # Fallback 404 with CORS headers
    location / {
      add_header Access-Control-Allow-Origin $http_origin always;
      add_header Access-Control-Allow-Credentials "true" always;
      add_header Access-Control-Allow-Headers "Authorization,Content-Type,Accept,Origin,Cache-Control,X-Requested-With" always;
      add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
      add_header Vary "Origin" always;

      if ($request_method = OPTIONS) {
        return 204;
      }

      return 404;
    }
  }
}
